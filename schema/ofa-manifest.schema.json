{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofa-format.org/schema/0.1/ofa-manifest.schema.json",
  "title": "OFA package manifest (ofa.json), version 0.1",
  "type": "object",
  "required": ["ofa", "streams"],
  "properties": {
    "ofa": { "type": "string", "pattern": "^0\\.1$" },
    "id": { "type": "string", "format": "uri" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "created": { "type": "string", "format": "date-time" },
    "modified": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "uri": { "type": "string", "format": "uri" }
      }
    },
    "primary": { "$ref": "#/$defs/streamId" },
    "lang": { "type": "string" },
    "metadata": { "type": "object" },
    "extensions": { "$ref": "#/$defs/extensions" },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/extensionId" },
      "uniqueItems": true
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stream" }
    }
  },
  "$defs": {
    "streamId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "extensionId": {
      "type": "string",
      "description": "Reverse domain name (org.example.feature) or absolute URI.",
      "pattern": "^([a-z0-9-]+(\\.[a-z0-9-]+)+(\\.[A-Za-z0-9_-]+)*|[A-Za-z][A-Za-z0-9+.-]*:.+)$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/extensionId" }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.{1,2}(/|$)" },
          { "pattern": "[\\\\:\\u0000-\\u001f]" },
          { "pattern": "/$" },
          { "pattern": "^(mimetype|ofa\\.json)$" },
          { "pattern": "^(signatures|META-INF|_ofa)/" }
        ]
      }
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*(\\s*;.*)?$"
    },
    "schemaRef": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "stream": { "$ref": "#/$defs/streamId" },
        "inline": {},
        "uri": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      },
      "oneOf": [
        { "required": ["stream"] },
        { "required": ["inline"] },
        { "required": ["uri"] }
      ]
    },
    "stream": {
      "type": "object",
      "required": ["id", "path", "media_type", "size", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/streamId" },
        "path": { "$ref": "#/$defs/path" },
        "media_type": { "$ref": "#/$defs/mediaType" },
        "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "content_encoding": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "role": {
          "type": "string",
          "description": "Registry term (Appendix A.1) or absolute URI."
        },
        "schema": { "$ref": "#/$defs/schemaRef" },
        "describes": {
          "type": "array",
          "items": { "$ref": "#/$defs/streamId" },
          "uniqueItems": true
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "lang": { "type": "string" },
        "metadata": { "type": "object" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
