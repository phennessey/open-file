{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ofa-format.org/profiles/0.2/datapackage.json",
  "title": "OFA profile for Data Package v2, version 0.2",
  "description": "A datapackage.json inside an .ofa file must be valid against the Data Package v2 profile and against the OFA rules in definitions/ofa. ofa-format.org is a placeholder until the project has a domain.",
  "allOf": [
    { "$ref": "https://datapackage.org/profiles/2.0/datapackage.json" },
    { "$ref": "#/definitions/ofa" }
  ],
  "definitions": {
    "ofa": {
      "type": "object",
      "required": ["$schema", "_ofa", "resources"],
      "properties": {
        "$schema": { "type": "string", "format": "uri" },
        "_ofa": { "$ref": "#/definitions/packageExt" },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/resource" }
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "extensionId": {
      "type": "string",
      "description": "Reverse domain name (org.example.feature) or absolute URI.",
      "pattern": "^([a-z0-9-]+(\\.[a-z0-9-]+)+(\\.[A-Za-z0-9_-]+)*|[A-Za-z][A-Za-z0-9+.-]*:.+)$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/extensionId" }
    },
    "packageExt": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "modified": { "type": "string", "format": "date-time" },
        "generator": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "uri": { "type": "string", "format": "uri" }
          }
        },
        "primary": { "$ref": "#/definitions/name" },
        "lang": { "type": "string" },
        "metadata": { "type": "object" },
        "extensions": { "$ref": "#/definitions/extensions" },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/definitions/extensionId" },
          "uniqueItems": true
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "://" },
          { "pattern": "(^|/)\\." },
          { "pattern": "[\\\\:\\u0000-\\u001f]" },
          { "pattern": "/$" },
          { "pattern": "^(mimetype|datapackage\\.json)$" },
          { "pattern": "^(signatures|META-INF|_ofa)/" }
        ]
      }
    },
    "schemaRef": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "resource": { "$ref": "#/definitions/name" },
        "inline": {},
        "uri": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      },
      "oneOf": [
        { "required": ["resource"] },
        { "required": ["inline"] },
        { "required": ["uri"] }
      ]
    },
    "resourceExt": {
      "type": "object",
      "properties": {
        "contentEncoding": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "role": {
          "type": "string",
          "description": "Registry term (SPEC Appendix A.1) or absolute URI."
        },
        "schema": { "$ref": "#/definitions/schemaRef" },
        "describes": {
          "type": "array",
          "items": { "$ref": "#/definitions/name" },
          "uniqueItems": true
        },
        "lang": { "type": "string" },
        "metadata": { "type": "object" },
        "extensions": { "$ref": "#/definitions/extensions" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["name", "path", "mediatype", "bytes", "hash"],
      "not": { "required": ["data"] },
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "path": { "$ref": "#/definitions/path" },
        "mediatype": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*(\\s*;.*)?$"
        },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "_ofa": { "$ref": "#/definitions/resourceExt" }
      }
    }
  }
}
